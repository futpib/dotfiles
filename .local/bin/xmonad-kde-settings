#!/usr/bin/env python3
"""Apply saved KDE appearance, scaling and input settings to a standalone X11 session."""

import argparse
import ctypes
import fcntl
import hashlib
import json
import math
import os
from pathlib import Path
import re
import select
import signal
import subprocess
import sys
import time


class SettingsError(Exception):
    pass


def run(args, **kwargs):
    try:
        return subprocess.run(
            args, check=True, text=True, capture_output=True, timeout=10, **kwargs
        ).stdout
    except subprocess.CalledProcessError as error:
        detail = (error.stderr or error.stdout or "").strip()
        raise SettingsError(
            f"{args[0]} failed (exit {error.returncode})" + (f": {detail}" if detail else "")
        ) from error


def scale_number(value):
    try:
        result = float(value)
    except (ValueError, TypeError) as error:
        raise SettingsError(f"Invalid KDE scale: {value!r}") from error
    if not math.isfinite(result) or not 0 < result <= 5:
        raise SettingsError(f"Invalid KDE scale: {value!r}")
    return result


def uniform_scale(values, source):
    scales = {scale_number(value) for value in values}
    if len(scales) > 1:
        raise SettingsError(
            f"{source} has mixed monitor scales {sorted(scales)}; "
            "this X11 bridge requires a uniform scale"
        )
    return next(iter(scales)) if scales else None


def connector(name):
    return name.replace("HDMI-A-", "HDMI-")


def resolve_scale(global_scale, screen_scales, wayland, outputs, xwayland_scale, font_dpi):
    if global_scale:
        return scale_number(global_scale), "kdeglobals / KScreen / ScaleFactor"
    if screen_scales:
        entries = [entry for entry in screen_scales.split(";") if entry]
        named = [entry.rsplit("=", 1) for entry in entries if "=" in entry]
        values = [value for name, value in named if connector(name) in outputs]
        if not values:
            values = [entry.rsplit("=", 1)[-1] for entry in entries]
        value = uniform_scale(values, "KScreen / ScreenScaleFactors")
        if value is not None:
            return value, "kdeglobals / KScreen / ScreenScaleFactors"
    if wayland is not None:
        if not isinstance(wayland, list) or any(not isinstance(item, dict) for item in wayland):
            raise SettingsError("Unexpected kwinoutputconfig.json structure")
        stores = [item for item in wayland if item.get("name") == "outputs"]
        if not stores or not isinstance(stores[0].get("data"), list):
            raise SettingsError("kwinoutputconfig.json has no outputs array")
        saved = stores[0]["data"]
        if any(not isinstance(item, dict) or not isinstance(item.get("connectorName", ""), str)
               for item in saved):
            raise SettingsError("kwinoutputconfig.json contains an invalid output")
        matching = [item for item in saved if connector(item.get("connectorName", "")) in outputs]
        candidates = matching or saved
        value = uniform_scale(
            [item["scale"] for item in candidates if "scale" in item],
            "kwinoutputconfig.json",
        )
        if value is not None:
            return value, "kwinoutputconfig.json / outputs / scale"
    if xwayland_scale:
        return scale_number(xwayland_scale), "kwinrc / Xwayland / Scale"
    if font_dpi and float(font_dpi) > 0:
        return scale_number(float(font_dpi) / 96), "kcmfonts / General / forceFontDPI"
    return 1.0, "KDE default (no saved scaling override)"


class Preferences:
    def __init__(self):
        self.home = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
        directories = os.environ.get("XDG_CONFIG_DIRS", "/etc/xdg").split(":")
        self.dirs = list(dict.fromkeys([self.home, self.home / "kdedefaults", *map(Path, directories)]))
        self.cache = {}

    def read(self, filename, group, key, default=""):
        groups = (group,) if isinstance(group, str) else tuple(group)
        cache_key = filename, groups, key, default
        if cache_key not in self.cache:
            self.cache[cache_key] = run([
                "kreadconfig6", "--file", filename,
                *[arg for group in groups for arg in ("--group", group)],
                "--key", key, "--default", str(default),
            ]).rstrip("\n")
        return self.cache[cache_key]

    def files(self):
        names = ("kdeglobals", "kwinrc", "kwinoutputconfig.json", "kcminputrc", "kcmfonts",
                 "kxkbrc", "touchpadxlibinputrc")
        return [directory / name for directory in self.dirs for name in names] + [
            Path.home() / ".xsettingsd", self.home / "xsettingsd/xsettingsd.conf",
        ]

    def signature(self):
        result = []
        for path in self.files():
            try:
                stat = path.stat()
                result.append((str(path), stat.st_mtime_ns, stat.st_size, stat.st_ino))
            except FileNotFoundError:
                result.append((str(path), None))
        return result

    def settings(self, outputs):
        self.cache.clear()
        global_scale = self.read("kdeglobals", "KScreen", "ScaleFactor")
        screen_scales = self.read("kdeglobals", "KScreen", "ScreenScaleFactors")
        wayland_file = next((directory / "kwinoutputconfig.json" for directory in self.dirs
                             if (directory / "kwinoutputconfig.json").exists()), None)
        wayland = (json.loads(wayland_file.read_text())
                   if wayland_file and not (global_scale or screen_scales) else None)
        scale, source = resolve_scale(
            global_scale, screen_scales,
            wayland, outputs,
            self.read("kwinrc", "Xwayland", "Scale"),
            self.read("kcmfonts", "General", "forceFontDPI"),
        )
        dpi = round(96 * scale)
        cursor_theme = self.read("kcminputrc", "Mouse", "cursorTheme", "breeze_cursors")
        cursor_base_size = int(self.read("kcminputrc", "Mouse", "cursorSize", "24"))
        if cursor_base_size < 0:
            raise SettingsError(f"Invalid KDE cursor size: {cursor_base_size}")
        cursor_size = max(1, round((cursor_base_size or 24) * scale))
        hint = self.read("kdeglobals", "General", "XftHintStyle", "hintslight")
        if hint not in ("hintnone", "hintslight", "hintmedium", "hintfull"):
            raise SettingsError(f"Invalid KDE font hint style: {hint!r}")
        rgba = self.read("kdeglobals", "General", "XftSubPixel", "rgb")
        if rgba not in ("none", "rgb", "bgr", "vrgb", "vbgr"):
            raise SettingsError(f"Invalid KDE subpixel order: {rgba!r}")
        if any(char in cursor_theme for char in "\r\n"):
            raise SettingsError("Invalid multiline KDE cursor theme")
        antialias = self.read("kdeglobals", "General", "XftAntialias", "true").lower() == "true"
        resources = {
            "Xft.dpi": dpi, "Xft.antialias": int(antialias),
            "Xft.hinting": int(hint != "hintnone"), "Xft.hintstyle": hint,
            "Xft.rgba": rgba, "Xcursor.theme": cursor_theme, "Xcursor.size": cursor_size,
        }
        settings = {
            "Xft/DPI": round(96 * scale * 1024), "Xft/Antialias": int(antialias),
            "Xft/Hinting": int(hint != "hintnone"), "Xft/HintStyle": hint,
            "Xft/RGBA": rgba, "Gtk/CursorThemeName": cursor_theme,
            "Gtk/CursorThemeSize": cursor_size,
        }
        baseline = ""
        for path in (Path.home() / ".xsettingsd", self.home / "xsettingsd/xsettingsd.conf"):
            if path.exists():
                baseline = path.read_text()
                break
        lines = [line for line in baseline.splitlines()
                 if not line.split() or line.split()[0] not in settings]
        lines.extend(f"{key} {json.dumps(value, ensure_ascii=False)}" for key, value in settings.items())
        return {
            "scale": scale, "source": source, "dpi": dpi,
            "cursor_theme": cursor_theme, "cursor_size": cursor_size,
            "cursor_base_size": cursor_base_size,
            "resources": "".join(f"{key}: {value}\n" for key, value in resources.items()),
            "xsettings": "\n".join(lines) + "\n",
        }


def active_outputs():
    text = run(["xrandr", "--query"])
    return tuple(connector(match.group(1)) for match in re.finditer(
        r"^(\S+) connected(?: primary)? \d+x\d+[+-]\d+[+-]\d+", text, re.M
    ))


def runtime_dir():
    display = os.environ.get("DISPLAY")
    if not display:
        raise SettingsError("DISPLAY is unset; run this from an X11 session")
    base = os.environ.get("XDG_RUNTIME_DIR")
    if not base:
        raise SettingsError("XDG_RUNTIME_DIR is unset")
    suffix = hashlib.sha256(display.encode()).hexdigest()[:12]
    path = Path(base) / f"xmonad-kde-settings-{suffix}"
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    return path


def atomic_write(path, contents):
    temporary = path.with_suffix(".tmp")
    temporary.write_text(contents)
    temporary.replace(path)


class CursorTheme:
    def __init__(self):
        x11 = ctypes.CDLL("libX11.so.6")
        xcursor = ctypes.CDLL("libXcursor.so.1")
        xfixes = ctypes.CDLL("libXfixes.so.3")
        pointer, integer, xid, string = ctypes.c_void_p, ctypes.c_int, ctypes.c_ulong, ctypes.c_char_p

        def bind(library, name, result, *arguments):
            function = getattr(library, name)
            function.restype = result
            function.argtypes = arguments
            return function

        open_display = bind(x11, "XOpenDisplay", pointer, string)
        self.close_display = bind(x11, "XCloseDisplay", integer, pointer)
        self.root_window = bind(x11, "XDefaultRootWindow", xid, pointer)
        self.define_cursor = bind(x11, "XDefineCursor", integer, pointer, xid, xid)
        self.free_cursor = bind(x11, "XFreeCursor", integer, pointer, xid)
        self.sync = bind(x11, "XSync", integer, pointer, integer)
        self.set_theme = bind(xcursor, "XcursorSetTheme", integer, pointer, string)
        self.set_size = bind(xcursor, "XcursorSetDefaultSize", integer, pointer, integer)
        self.load_cursor = bind(xcursor, "XcursorLibraryLoadCursor", xid, pointer, string)
        query_extension = bind(xfixes, "XFixesQueryExtension", integer, pointer,
                               ctypes.POINTER(integer), ctypes.POINTER(integer))
        self.replace_cursor = bind(xfixes, "XFixesChangeCursorByName", None, pointer, xid, string)
        self.display = open_display(None)
        if not self.display:
            raise SettingsError("Cannot open the X11 display to apply the cursor")
        self.can_replace = query_extension(self.display, ctypes.byref(integer()), ctypes.byref(integer()))

    def apply(self, theme, size):
        self.set_theme(self.display, (theme or "default").encode())
        self.set_size(self.display, size)
        names = (
            "left_ptr default arrow top_left_arrow left_arrow up_arrow center_ptr "
            "cross crosshair wait watch ibeam text xterm "
            "size_ver ns-resize v_double_arrow sb_v_double_arrow "
            "size_hor ew-resize h_double_arrow sb_h_double_arrow "
            "size_bdiag nesw-resize top_right_corner bottom_left_corner "
            "size_fdiag nwse-resize top_left_corner bottom_right_corner "
            "size_all fleur move split_v row-resize split_h col-resize "
            "pointing_hand pointer hand1 hand2 forbidden not-allowed crossed_circle circle "
            "whats_this help question_arrow left_ptr_watch half-busy progress "
            "openhand grab closedhand grabbing dnd-copy copy dnd-move dnd-link link"
        ).split()
        for name in names:
            cursor = self.load_cursor(self.display, name.encode())
            if not cursor:
                if name == "left_ptr":
                    raise SettingsError(f"Cannot load the pointer from cursor theme {theme!r}")
                continue
            try:
                if self.can_replace:
                    self.replace_cursor(self.display, cursor, name.encode())
            finally:
                self.free_cursor(self.display, cursor)
        cursor = self.load_cursor(self.display, b"left_ptr")
        try:
            self.define_cursor(self.display, self.root_window(self.display), cursor)
        finally:
            self.free_cursor(self.display, cursor)
        self.sync(self.display, False)

    def close(self):
        self.close_display(self.display)


def notify_kde():
    for change in (0, 2, 4, 5):
        run(["dbus-send", "--session", "--type=signal", "/KGlobalSettings",
             "org.kde.KGlobalSettings.notifyChange", f"int32:{change}", "int32:0"])
    run(["dbus-send", "--session", "--type=signal", "/KDEPlatformTheme",
         "org.kde.KDEPlatformTheme.refreshFonts"])


def boolean(value):
    if str(value).lower() not in ("true", "false", "1", "0"):
        raise SettingsError(f"Invalid KDE boolean: {value!r}")
    return str(value).lower() in ("true", "1")


class InputSettings:
    boolean_properties = {
        "LeftHanded": ("libinput Left Handed Enabled", "XLbInptLeftHanded"),
        "NaturalScroll": ("libinput Natural Scrolling Enabled", "XLbInptNaturalScroll"),
        "MiddleButtonEmulation": ("libinput Middle Emulation Enabled", "XLbInptMiddleEmulation"),
        "DisableWhileTyping": ("libinput Disable While Typing Enabled", ""),
        "TapToClick": ("libinput Tapping Enabled", ""),
        "TapAndDrag": ("libinput Tapping Drag Enabled", ""),
        "TapDragLock": ("libinput Tapping Drag Lock Enabled", ""),
        "ScrollButtonLock": ("libinput Button Scrolling Button Lock Enabled", ""),
    }

    def __init__(self, preferences):
        self.preferences = preferences
        self.previous = None
        self.original = {}
        self.keyboard_previous = None
        self.keyboard_report = ({}, [])
        self.report = {"devices": [], "keyboard": {}, "warnings": [], "errors": []}

    def device(self, device_id):
        text = run(["xinput", "list-props", device_id])
        properties = {match[1]: match[2].split(", ") for match in re.finditer(
            r"^\s+(.+) \(\d+\):\s*(.*)$", text, re.M
        )}
        if "Device Product ID" not in properties or not any(
                prop in properties for prop in ("libinput Accel Speed", "libinput Tapping Enabled",
                                                "libinput Natural Scrolling Enabled")):
            return None
        name = text.splitlines()[0][8:-2]
        vendor, product = properties["Device Product ID"]
        identity = (device_id, name, vendor, product, tuple(properties.get("Device Node", [])))
        touchpad = "libinput Tapping Enabled" in properties
        group = ("Libinput", vendor, product, name)
        original = self.original.setdefault(identity, {})
        desired = {}
        warnings = []

        def saved(key, legacy="", touchpad_key=None):
            value = self.preferences.read("kcminputrc", group, key)
            if value:
                return value
            if touchpad:
                key = touchpad_key or key[0].lower() + key[1:]
                return self.preferences.read("touchpadxlibinputrc", name, key)
            return self.preferences.read("kcminputrc", "Mouse", legacy) if legacy else ""

        def put(prop, values, available=None):
            if prop not in properties:
                warnings.append(f"{name}: {prop} is unsupported")
                return
            if available and any(value and not int(supported) for value, supported in
                                 zip(values, properties.get(available, []))):
                warnings.append(f"{name}: requested {prop} mode is unsupported")
                return
            desired[prop] = [str(value) for value in values]

        for key, (prop, legacy) in self.boolean_properties.items():
            value = saved(key, legacy, "middleEmulation" if key == "MiddleButtonEmulation" else None)
            if value:
                put(prop, [int(boolean(value))])
        value = saved("PointerAcceleration", "XLbInptPointerAcceleration")
        if value:
            speed = float(value)
            if not math.isfinite(speed) or not -1 <= speed <= 1:
                raise SettingsError(f"{name}: invalid pointer acceleration {value!r}")
            put("libinput Accel Speed", [speed])
        profile = self.preferences.read("kcminputrc", group, "PointerAccelerationProfile")
        if not profile:
            flat = saved("PointerAccelerationProfileFlat", "XLbInptAccelProfileFlat")
            if flat:
                profile = "1" if boolean(flat) else "2"
        if profile:
            prop = "libinput Accel Profile Enabled"
            count = len(properties.get(prop, [0, 0, 0]))
            if int(profile) not in (1, 2, 4) or (int(profile) == 4 and count < 3):
                raise SettingsError(f"{name}: unsupported acceleration profile {profile!r}")
            put(prop, [int(int(profile) == flag) for flag in (2, 1, 4)[:count]],
                available="libinput Accel Profiles Available")
        for key, prop, available, flags, old_keys in (
            ("ScrollMethod", "libinput Scroll Method Enabled", "libinput Scroll Methods Available",
             (1, 2, 4), ("scrollTwoFinger", "scrollEdge", "scrollOnButtonDown")),
            ("ClickMethod", "libinput Click Method Enabled", "libinput Click Methods Available",
             (1, 2), ("clickMethodAreas", "clickMethodClickfinger")),
        ):
            value = self.preferences.read("kcminputrc", group, key)
            if value:
                if int(value) not in (0, *flags):
                    raise SettingsError(f"{name}: invalid {key}: {value!r}")
                put(prop, [int(int(value) == flag) for flag in flags], available=available)
            elif touchpad:
                values = [self.preferences.read("touchpadxlibinputrc", name, key) for key in old_keys]
                if any(values):
                    put(prop, [int(boolean(value or "false")) for value in values], available=available)
            elif key == "ScrollMethod":
                value = self.preferences.read("kcminputrc", "Mouse", "XLbInptScrollOnButtonDown")
                if value:
                    put(prop, [0, 0, int(boolean(value))], available=available)
        value = saved("LmrTapButtonMap")
        if value:
            put("libinput Tapping Button Mapping Enabled", [int(not boolean(value)), int(boolean(value))])
        if touchpad:
            value = self.preferences.read("touchpadxlibinputrc", name, "horizontalScrolling")
            if value:
                put("libinput Horizontal Scroll Enabled", [int(boolean(value))])
        value = saved("ScrollButton")
        if value:
            button = int(value)
            if self.preferences.read("kcminputrc", group, "ScrollButton"):
                button = {0: 0, 272: 1, 273: 3, 274: 2, 275: 8, 276: 9,
                          277: 10, 278: 11, 279: 12}.get(button)
            if button is None or not 0 <= button <= 32:
                warnings.append(f"{name}: unsupported scroll button {value}")
            else:
                put("libinput Button Scrolling Button", [button])
        enabled = saved("Enabled")
        external = saved("DisableEventsOnExternalMouse")
        if enabled or external:
            enabled = boolean(enabled or "true")
            external = boolean(external or "false")
            put("libinput Send Events Mode Enabled", [int(not enabled), int(enabled and external)],
                available="libinput Send Events Modes Available")
        factor = self.preferences.read("kcminputrc", group, "ScrollFactor")
        if factor and float(factor) != 1:
            warnings.append(f"{name}: KWin ScrollFactor has no equivalent Xorg wheel-speed setting")
        for prop in desired:
            original.setdefault(prop, properties[prop])
        changes = {**{prop: value for prop, value in original.items() if prop not in desired}, **desired}
        for prop, values in changes.items():
            if properties[prop] != values:
                run(["xinput", "set-prop", device_id, prop, *values])
        for prop in set(original) - set(desired):
            del original[prop]
        return identity, {"id": device_id, "name": name, "properties": desired}, warnings

    def keyboard(self, devices):
        read = self.preferences.read
        arguments = []
        values = {key: read("kxkbrc", "Layout", key) for key in
                  ("Model", "LayoutList", "VariantList", "Options", "Use", "ResetOldOptions")}
        repeat = {key: read("kcminputrc", "Keyboard", key)
                  for key in ("KeyRepeat", "RepeatDelay", "RepeatRate")}
        switch = read("kxkbrc", "Layout", "SwitchMode")
        signature = tuple(values.items()), tuple(repeat.items()), switch, devices
        if signature == self.keyboard_previous:
            return self.keyboard_report
        if values["Model"]:
            arguments.extend(["-model", values["Model"]])
        if boolean(values["Use"] or "false") and values["LayoutList"]:
            if len(values["LayoutList"].split(",")) > 4:
                raise SettingsError("X11 supports at most four keyboard layouts")
            arguments.extend(["-layout", values["LayoutList"], "-variant", values["VariantList"]])
        if boolean(values["ResetOldOptions"] or "false"):
            arguments.extend(["-option", ""])
        for option in filter(None, values["Options"].split(",")):
            arguments.extend(["-option", option])
        if arguments:
            run(["setxkbmap", *arguments])
        warnings = []
        if any(repeat.values()):
            mode = repeat["KeyRepeat"] or "repeat"
            if mode in ("repeat", "accent"):
                delay = int(repeat["RepeatDelay"] or 600)
                rate = float(repeat["RepeatRate"] or 25)
                if not 100 <= delay <= 5000 or not 0.2 <= rate <= 200:
                    raise SettingsError(f"Invalid KDE repeat delay/rate: {delay}/{rate}")
                run(["xset", "r", "on"])
                x11 = ctypes.CDLL("libX11.so.6")
                x11.XOpenDisplay.restype = ctypes.c_void_p
                x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
                x11.XkbSetAutoRepeatRate.argtypes = [ctypes.c_void_p, ctypes.c_uint,
                                                    ctypes.c_uint, ctypes.c_uint]
                x11.XCloseDisplay.argtypes = [ctypes.c_void_p]
                display = x11.XOpenDisplay(None)
                if not display:
                    raise SettingsError("Cannot open X11 to set keyboard repeat")
                try:
                    if not x11.XkbSetAutoRepeatRate(display, 0x100, delay, round(1000 / rate)):
                        raise SettingsError("XKB could not apply keyboard repeat")
                finally:
                    x11.XCloseDisplay(display)
                if mode == "accent":
                    warnings.append("Plasma's hold-key accent menu is unavailable; using key repeat")
            elif mode in ("nothing", "none"):
                run(["xset", "r", "off"])
            else:
                raise SettingsError(f"Unsupported KDE KeyRepeat mode: {mode!r}")
        if switch and switch != "Global":
            warnings.append("Per-window/application keyboard layouts require Plasma; using a global layout")
        self.keyboard_previous = signature
        self.keyboard_report = {"setxkbmap": arguments, **repeat}, warnings
        return self.keyboard_report

    def poll(self):
        errors = []
        try:
            listing = run(["xinput", "--list", "--short"])
            signature = self.preferences.signature(), listing
            if signature == self.previous:
                return self.report
            self.preferences.cache.clear()
            report = {"devices": [], "keyboard": {}, "warnings": [], "errors": errors}
            present = set()
            for device_id in re.findall(r"\bid=(\d+)\b", listing):
                try:
                    result = self.device(device_id)
                    if result:
                        identity, device, warnings = result
                        present.add(identity)
                        if device["properties"]:
                            report["devices"].append(device)
                        report["warnings"].extend(warnings)
                except (OSError, ValueError, SettingsError, subprocess.SubprocessError) as error:
                    errors.append(f"Device {device_id}: {error}")
            if not errors:
                self.original = {key: value for key, value in self.original.items() if key in present}
            try:
                keyboards = tuple(re.findall(r"id=(\d+)\s+\[[^\n]*keyboard", listing))
                report["keyboard"], warnings = self.keyboard(keyboards)
                report["warnings"].extend(warnings)
            except (OSError, ValueError, SettingsError, subprocess.SubprocessError) as error:
                errors.append(f"Keyboard: {error}")
            self.previous = None if errors else signature
        except (OSError, ValueError, SettingsError, subprocess.SubprocessError) as error:
            report = {**self.report, "errors": [f"Input settings: {error}; install xorg-xinput and xorg-setxkbmap"]}
        if report != self.report:
            for message in report["warnings"] + report["errors"]:
                print(f"xmonad-kde-settings: {message}", file=sys.stderr, flush=True)
        self.report = report
        return report


def watch(directory):
    with (directory / "lock").open("w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print("ready", flush=True)
            return
        preferences = Preferences()
        inputs = InputSettings(preferences)
        applied = {}
        cursors = None
        daemon = None
        previous = None
        stopping = False

        def stop(*_):
            nonlocal stopping
            stopping = True

        signal.signal(signal.SIGTERM, stop)
        signal.signal(signal.SIGINT, stop)
        try:
            while not stopping:
                if daemon is not None and daemon.poll() is not None:
                    raise SettingsError("xsettingsd exited; ending this display's settings watcher")
                try:
                    outputs = active_outputs()
                    signature = preferences.signature(), outputs
                    if signature != previous:
                        settings = preferences.settings(outputs)
                        config = directory / "xsettingsd.conf"
                        atomic_write(config, settings["xsettings"])
                        run(["xrdb", "-merge", "-nocpp"], input=settings["resources"])
                        if daemon is None:
                            daemon = subprocess.Popen(["xsettingsd", "--config", str(config)], stdout=sys.stderr)
                            time.sleep(0.15)
                            if daemon.poll() is not None:
                                raise SettingsError("xsettingsd could not acquire the display's settings selection")
                        else:
                            daemon.send_signal(signal.SIGHUP)
                        notify_kde()
                        if cursors is None:
                            cursors = CursorTheme()
                        cursors.apply(settings["cursor_theme"], settings["cursor_size"])
                        applied = {
                            "pid": os.getpid(), "display": os.environ["DISPLAY"],
                            "scale": settings["scale"], "dpi": settings["dpi"],
                            "source": settings["source"],
                            "cursor_theme": settings["cursor_theme"],
                            "cursor_size": settings["cursor_size"],
                            "cursor_base_size": settings["cursor_base_size"],
                        }
                        print(f"Applied {settings['scale'] * 100:g}% from {settings['source']}", file=sys.stderr, flush=True)
                        first = previous is None
                        previous = signature
                    else:
                        first = False
                    applied["input"] = inputs.poll()
                    atomic_write(directory / "status.json", json.dumps(applied, indent=2) + "\n")
                    if first:
                        print("ready", flush=True)
                except (OSError, ValueError, SettingsError, subprocess.SubprocessError) as error:
                    if previous is None:
                        raise
                    print(f"xmonad-kde-settings: {error}", file=sys.stderr, flush=True)
                time.sleep(2)
        finally:
            if cursors is not None:
                cursors.close()
            if daemon is not None and daemon.poll() is None:
                daemon.terminate()
                daemon.wait(timeout=5)
            (directory / "status.json").unlink(missing_ok=True)


def log_path():
    log_dir = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "xmonad"
    return log_dir / "kde-settings.log"


def start(directory):
    path = log_path()
    log_dir = path.parent
    log_dir.mkdir(parents=True, exist_ok=True)
    with path.open("a+") as log:
        log.seek(0, os.SEEK_END)
        offset = log.tell()
        child = subprocess.Popen(
            [sys.executable, str(Path(__file__).resolve()), "--watch"],
            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=log,
            start_new_session=True, text=True,
        )
        try:
            readable, _, _ = select.select([child.stdout], [], [], 30)
            if not readable or child.stdout.readline().strip() != "ready":
                child.terminate()
                child.wait(timeout=5)
                log.seek(offset)
                detail = log.read().strip() or (
                    "Watcher exited without reporting readiness" if readable
                    else "Watcher did not report readiness within 30 seconds"
                )
                raise SettingsError(f"Settings startup failed:\n{detail}\nLog: {path}")
        except BaseException:
            child.terminate()
            child.wait(timeout=5)
            raise
        finally:
            child.stdout.close()


def status(directory):
    try:
        return (directory / "status.json").read_text()
    except FileNotFoundError as error:
        raise SettingsError(
            f"No applied settings for DISPLAY={os.environ['DISPLAY']}. "
            "The watcher has not started successfully, or has exited.\n"
            "Run ~/.local/bin/xmonad-kde-settings --start to start it and show any startup error.\n"
            f"Log: {log_path()}"
        ) from error


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--start", action="store_true", help="start once per display and wait until settings are applied")
    mode.add_argument("--watch", action="store_true", help="run the settings watcher in the foreground")
    mode.add_argument("--status", action="store_true", help="print the last applied settings")
    args = parser.parse_args()
    directory = runtime_dir()
    if args.start:
        start(directory)
    elif args.watch:
        watch(directory)
    else:
        print(status(directory), end="")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, SettingsError, subprocess.SubprocessError) as error:
        print(f"xmonad-kde-settings: {error}", file=sys.stderr)
        sys.exit(1)
