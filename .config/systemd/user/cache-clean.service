[Unit]
Description=Reclaim disk space with staged LRU cache cleanup

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=CACHE_CLEAN_LOW_WATERMARK=5%%
Environment=CACHE_CLEAN_HIGH_WATERMARK=8%%
EnvironmentFile=-%h/.config/cache-clean.conf
ExecStart=%h/.local/bin/cache-clean --pressure --apply --retry-after 300
Nice=19
IOSchedulingClass=idle
CPUWeight=10
CPUQuota=100%
IOWeight=10
UMask=0077
NoNewPrivileges=yes
# Large Gradle caches require holding thousands of locks during deletion.
LimitNOFILE=65536
TimeoutStartSec=30min
