[Unit]
Description=Screen locking for xmonad
PartOf=xmonad-session.target
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=exec
ExecCondition=%h/.local/bin/xmonad-kde-settings --check-display --environment %t/xmonad-kde-settings/environment.json
ExecStart=%h/.local/bin/xmonad-kde-settings --screen-lock-daemon --environment %t/xmonad-kde-settings/environment.json
Restart=on-failure
RestartSec=1
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xmonad-screen-lock
